# ============================================
# Veldic Wear — Environment Variables
# Copy this file to .env for local development.
# For production, paste ALL of these into Netlify
# Site settings → Environment variables.
# ============================================

# --- Production URL (IMPORTANT: change from localhost) ---
NEXT_PUBLIC_BASE_URL=https://veldicwear.com
# Better Auth URL (same as base URL in production)
BETTER_AUTH_URL=https://veldicwear.com

# --- Database (Neon PostgreSQL) ---
# NOTE: use `sslmode=verify-full`. node-postgres (pg) treats `sslmode=require`
# / `prefer` / `verify-ca` as aliases for `verify-full` and prints a
# SECURITY WARNING at runtime; spelling it out avoids the warning.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=verify-full

# --- Better Auth ---
BETTER_AUTH_SECRET=your-better-auth-secret

# --- Admin ---
ADMIN_SECRET=your-admin-secret

# --- Email (Gmail SMTP) ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-gmail-app-password
EMAIL_FROM="Veldic Wear <your-email@gmail.com>"
CONTACT_EMAIL_TO=your-email@gmail.com

# --- Cloudinary (admin product image uploads) ---
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your-upload-preset

# --- CJ Dropshipping ---
CJ_API_KEY=your-cj-api-key
CRON_SECRET=your-cron-secret

# --- Returns Management ---
# Optional: Domestic return address for customer remorse/sizing returns.
# If left empty, support replies handle returns on a case-by-case basis.
RETURN_SHIPPING_ADDRESS="Veldic Wear Returns, 123 Fashion Blvd, Suite 100, City, ST 12345"

# --- Stripe ---
STRIPE_SECRET_KEY=sk_live_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...